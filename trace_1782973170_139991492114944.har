 }\n\n  .p-menu {\n    gap: 3px;\n  }\n\n  .p-menu li a {\n    font-size: 13px; /* Increased by 2px for mobile */\n    padding: 6px 10px; /* Increased padding */\n  }\n}\n</style>\n\n<script>\ndocument.addEventListener('DOMContentLoaded', function () {\n  const menuContainer = document.querySelector('.p-menu-container');\n  let isDown = false;\n  let startX;\n  let scrollLeft;\n\n  menuContainer.addEventListener('mousedown', startScroll);\n  menuContainer.addEventListener('touchstart', startScroll);\n\n  function startScroll(e) {\n    isDown = true;\n    menuContainer.classList.add('active');\n    startX = e.pageX || e.touches[0].clientX;\n    scrollLeft = menuContainer.scrollLeft;\n  }\n\n  menuContainer.addEventListener('mouseup', stopScroll);\n  menuContainer.addEventListener('mouseleave', stopScroll);\n  menuContainer.addEventListener('touchend', stopScroll);\n\n  function stopScroll() {\n    isDown = false;\n    menuContainer.classList.remove('active');\n  }\n\n  menuContainer.addEventListener('mousemove', dragScroll);\n  menuContainer.addEventListener('touchmove', dragScroll);\n\n  function dragScroll(e) {\n    if (!isDown) return;\n    e.preventDefault();\n    const x = e.pageX || e.touches[0].clientX;\n    const walk = (x - startX) * 2;\n    menuContainer.scrollLeft = scrollLeft - walk;\n  }\n});\n</script>\n</div><section id=\"shopify-section-template--18531424698425__image_banner\" class=\"shopify-section section\"><link href=\"//zenin.co.in/cdn/shop/t/8/assets/section-image-banner.css?v=124819179385751388401741092002\" rel=\"stylesheet\" type=\"text/css\" media=\"all\" />\n<style data-shopify>@media screen and (max-width: 749px) {\n      #Banner-template--18531424698425__image_banner::before,\n      #Banner-template--18531424698425__image_banner .banner__media::before,\n      #Banner-template--18531424698425__image_banner:not(.banner--mobile-bottom) .banner__content::before {\n        padding-bottom: 150.03990422984836%;\n        content: '';\n        dis